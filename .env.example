# near-watch + admin console. Copy to your secrets folder (never into the repo), fill in, and pass with
#   node --env-file=$SECRETS\near-watch.env src/main.ts
# Names only are required here; values below that are not secrets are the verified ones from docs/NEAR-GATES.md.

# --- keys (24+ characters each, and different from each other) ---
ADMIN_API_KEY=
NEAR_WATCH_INGEST_KEY=

# --- chain (testnet) ---
# GATE A4: Circle's testnet USDC on NEAR (6 decimals; read from ft_metadata at start-up)
NEAR_USDC_CONTRACT_TESTNET=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# Optional (GATE A5): defaults to near:testnet, the id @x402/near and the paywall use. Set only to override.
NEAR_CAIP2_TESTNET=
# The paywall's pay-to account (same value as the paywall's NEAR_PAY_TO_TESTNET)
NEAR_PAY_TO_TESTNET=

# --- providers ---
# QuickNode NEAR testnet (the URL contains the token: keep it secret; shown redacted everywhere)
QUICKNODE_NEAR_HTTP_TESTNET=
# Stored for later, unused until a NEAR push subscription is confirmed (DESIGN §3)
QUICKNODE_NEAR_WSS_TESTNET=
# Public fallback RPC (docs.near.org/api/rpc/providers)
NEAR_RPC_FALLBACK_URL_TESTNET=https://test.rpc.fastnear.com
# Optional: neardata API key for more than 180 requests/minute
NEARDATA_API_KEY=

# --- optional ---
# One paid call in USDC base units (0.01 USDC = 10000): buyer "calls left" and in-flight estimates
NEAR_CALL_PRICE_UNITS=

# --- admin console (apps/admin-console) ---
NEAR_WATCH_URL=http://127.0.0.1:8790
